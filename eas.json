{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.7:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.7:3000"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://TODO_REPLACE_WITH_PUBLIC_BACKEND_URL"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "TODO_YOUR_APP_STORE_CONNECT_NUMERIC_APP_ID"
      }
    }
  }
}
