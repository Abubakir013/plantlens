{
  "expo": {
    "name": "PlantLens",
    "slug": "plantlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plantlens",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abubakir.plantlens",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "PlantLens uses your camera to photograph and identify plants in real time.",
        "NSPhotoLibraryUsageDescription": "PlantLens accesses your photo library so you can identify plants from existing photos.",
        "NSPhotoLibraryAddUsageDescription": "PlantLens saves photos of identified plants to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0FDF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PlantLens to access your camera to identify plants.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PlantLens to access your photos to identify plants from your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0FDF4",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96380b6c-dd89-4991-a298-20c758a6c328"
      }
    }
  }
}
